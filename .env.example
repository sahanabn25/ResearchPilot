# Copy to .env and fill in. NEVER commit .env.

# ---- LLM provider (pick ONE) ----
# groq (default, free tier, no card): create a key at https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here

LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODELS=openai/gpt-oss-20b
# Other providers (set LLM_PROVIDER to one of these instead):
#   gemini      -> GEMINI_API_KEY=...  GEMINI_MODEL=gemini-2.5-flash  GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
#   openrouter  -> OPENROUTER_API_KEY=...  LLM_MODEL=<a model id ending in :free>
#   ollama      -> runs locally, no key: LLM_MODEL=llama3.1:8b  (install from ollama.com, `ollama pull llama3.1:8b`)
#   openai      -> any OpenAI-compatible server: LLM_BASE_URL=...  LLM_API_KEY=...  LLM_MODEL=...

# Optional: identifies you politely to Crossref (recommended)
CONTACT_EMAIL=
# Optional tuning
LLM_MAX_ATTEMPTS=4
LLM_TIMEOUT_SECONDS=90
HTTP_MAX_ATTEMPTS=3
HTTP_TIMEOUT_SECONDS=15
MAX_PAPERS=50
LOG_LEVEL=INFO
LOG_DIR=logs

# ---- Paper sources (all free) ----
# FREE OpenAlex key: create an account at openalex.org, copy key from openalex.org/settings/api.
# Optional. Do NOT add any payment method; the free daily allowance is plenty for this project.
OPENALEX_API_KEY=
OPENALEX_MAX_CALLS=100
# auto = Chroma if it works, else built-in BM25. Options: auto | chroma | lexical
VECTOR_BACKEND=auto
MEMORY_DB_PATH=data/memory.sqlite3
SEARCH_CACHE_DAYS=7

# ---- Workflow limits ----
DISCOVERY_LIMIT=10
# Free tiers cap tokens per minute (Groq: roughly 6,000-8,000 on some models), so keep prompts modest:
ANALYSIS_MAX_PAPERS=6
ANALYSIS_BATCH_SIZE=3
MIN_ABSTRACT_PAPERS=3
MAX_STEPS=12
MAX_GAP_QUESTIONS=5
MAX_ANSWER_CHARS=3000
HTTP_MAX_RETRY_WAIT=10
# 1 = one LLM call writes the literature-review and conclusion paragraphs (validated); 0 = computed text only
REPORT_USE_LLM=1

# ---- Option 2: uploaded papers ----
MAX_PDF_MB=15
MAX_PDF_PAGES=60
MAX_PDF_SECONDS=45
# Text sent to the LLM per extraction call. Lower it if your provider has a small tokens-per-minute limit.
PARSE_CHAR_BUDGET=9000
